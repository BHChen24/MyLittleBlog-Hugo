# Prohibited patterns for git-secrets, registered by scripts/setup-hooks.sh.
# One POSIX extended regex per line; blank lines and # comments are ignored.
# git-secrets joins these with | and hands them to grep -E, so PCRE inline
# flags such as (?i) are not available — spell out case variants instead.
ALGOLIA_ADMIN_KEY[[:space:]]*=[[:space:]]*['"]?[0-9a-zA-Z]{16,}
[Aa]dmin[_-]?[Kk]ey["'[:space:]:=]+[0-9a-f]{32}
[-]{5}BEGIN[[:space:]](RSA|EC|DSA|OPENSSH|PGP)[[:space:]]PRIVATE[[:space:]]KEY[-]{5}
(secret|password|passwd)[[:space:]]*[:=][[:space:]]*['"][^'"]{12,}['"]
