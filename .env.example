# Local only — never committed (.gitignore) and never in hugo.yaml.
#
# HUGO_PARAMS_* override the matching keys under `params` in hugo.yaml.
# params.algolia.appId -> HUGO_PARAMS_ALGOLIA_APPID
#
# The app ID and the search-only key are public: they ship inside the rendered
# HTML so the browser can query the index. They live here only to keep the
# repository free of credential-shaped strings, so the secret scanners need no
# exceptions.
HUGO_PARAMS_ALGOLIA_APPID=
HUGO_PARAMS_ALGOLIA_SEARCHAPIKEY=

# Read by scripts/algolia-push.mjs. The admin key grants write access and must
# never leave this file or the Vercel environment.
ALGOLIA_APP_ID=
ALGOLIA_ADMIN_KEY=
